<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h2 class="col-6 offset-3">SignUp in WanderLust</h2>
    <div class="col-6 offset-3">
        <form action="/signUp" method="POST" novalidate  class="needs-validation">
          <div class="mt-3">
             <label for="username" class="form-label">UserName</label>
              <input name="username"  type="text" class="form-control" required>
                <div class="valid-feedback">looks good!</div>
               <div class="invalid-feedback">Please enter valid data</div>
        </div>
        <div class="mt-3">
             <label for="email" class="form-label">Email</label>
              <input name="email"  type="email" class="form-control" required>
                <div class="valid-feedback">looks good!</div>
               <div class="invalid-feedback">Please enter valid data</div>
        </div>
         <div class="mt-3">
             <label for="password" class="form-label">Password</label>
              <input name="password"  type="password" class="form-control" required> 
                <div class="valid-feedback">looks good!</div>
               <div class="invalid-feedback">Please enter valid data</div>
        </div>
        <button type="submit" class="btn btn-success mb-3 mt-3" >submit</button>
        </form>
        </div>
        </div>